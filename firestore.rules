rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email.matches(".*@organizer\\.org$") ||
         request.auth.token.email == "adityapatraraj@gmail.com" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // Users Collection: Competitors can only read and update their OWN profile.
    // Secret Arena Tokens are shielded from other students.
    // Strict privilege escalation guard prevents changing role to 'admin'.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && 
        (request.resource.data.role == "player" || isAdmin());

      allow update: if isAdmin() || (
        isOwner(userId) && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.arena_token == resource.data.arena_token
      );

      allow delete: if isAdmin();
    }

    // Events Collection: Public read for tournament metadata, admin write for control
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      // Admin Tokens Collection: Organizers generate tokens, participants can verify them to elevate
      match /admin_tokens/{tokenId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Top 100 Leaderboard Cache: Read-only for all spectators (Quota Optimized single doc)
      match /cached_leaderboard/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Public Participants list: Displays handles & ranks on leaderboard.
      // Rate-limited and length-bounded to prevent write flooding and document bloat.
      match /participants/{userId} {
        allow read: if true;
        allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.handle is string &&
          request.resource.data.handle.size() <= 32;
        allow update: if isAdmin() || (
          isOwner(userId) && (
            !('updated_at' in resource.data) || 
            request.time >= resource.data.updated_at + duration.value(2, 's')
          ) &&
          request.resource.data.handle is string &&
          request.resource.data.handle.size() <= 32
        );
        allow delete: if isAdmin();
      }

      // Verified Wave Scores: Cryptographic HMAC and bounded score validation
      match /scores/{scoreId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.wave is number &&
          request.resource.data.wave >= 1 &&
          request.resource.data.wave <= 8 &&
          request.resource.data.hmac is string &&
          request.resource.data.hmac.size() >= 16;
        allow update, delete: if isAdmin();
      }

      // Squads / Teams Collection for Co-op CTF mode (Max 10 cadets per squad)
      match /teams/{teamId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.team_name is string &&
          request.resource.data.team_name.size() <= 40;
        allow update: if isAuthenticated() && (
          isAdmin() || (
            request.resource.data.team_name is string &&
            request.resource.data.team_name.size() <= 40 &&
            (!('members' in request.resource.data) || request.resource.data.members.size() <= 10)
          )
        );
        allow delete: if isAdmin();
      }
    }
  }
}

